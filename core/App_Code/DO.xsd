                         tblOrderAllocationList.OrderCartonQty, tblOrderAllocationList.shippedCartonQty
FROM            tblOrderAllocationList INNER JOIN
                         tblOrderAllocationListItems ON tblOrderAllocationList.OrderNo = tblOrderAllocationListItems.OrderNo INNER JOIN
